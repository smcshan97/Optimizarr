# Optimizarr Configuration
# Copy this file to .env and update with your values

# Security - CHANGE THESE!
# Leave OPTIMIZARR_SECRET_KEY unset: the app generates a random 64-char key on
# first run and persists it to data/.secret_key. Only set it here if you need a
# specific key (e.g. sharing one across machines). Placeholder values are
# rejected and fall back to the generated key.
#OPTIMIZARR_SECRET_KEY=
OPTIMIZARR_ADMIN_USERNAME=admin
OPTIMIZARR_ADMIN_PASSWORD=change-this-secure-password

# Application
OPTIMIZARR_HOST=0.0.0.0
OPTIMIZARR_PORT=5757
OPTIMIZARR_LOG_LEVEL=INFO

# Database
OPTIMIZARR_DB_PATH=/app/data/optimizarr.db

# JWT Settings
OPTIMIZARR_JWT_EXPIRATION_HOURS=24

# Docker User Mapping
PUID=1000
PGID=1000
TZ=America/New_York
